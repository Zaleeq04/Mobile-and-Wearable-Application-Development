<?xml version="1.0" encoding="utf-8"?>

<!-- Main layout container for homepage -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lightPurple">

    <!-- Button to open report submission screen -->
    <Button
        android:id="@+id/addReportBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report Lost or Found Item"
        android:backgroundTint="@color/primaryPurple"
        android:textColor="@android:color/white"/>

    <!-- Dropdown filter for report status or item category -->
    <Spinner
        android:id="@+id/filterSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Logout button for ending current user session -->
    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:backgroundTint="@color/primaryPurple"
        android:textColor="@android:color/white"/>

    <!-- RecyclerView displays all lost and found reports dynamically -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/reportsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="90dp"
        android:clipToPadding="false" />

    <!-- Bottom navigation menu for quick access to app features -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu" />

</LinearLayout>